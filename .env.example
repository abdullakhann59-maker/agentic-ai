# Copy this file to .env and change what you need.

# --- Ollama ---
OLLAMA_BASE_URL=http://localhost:11434
LLM_MODEL=qwen2.5:7b
EMBED_MODEL=nomic-embed-text
LLM_NUM_CTX=8192

# --- RAG thresholds (cosine similarity 0..1). Tune with your own data: see /stats path_performance ---
CHAT_THRESHOLD=0.80
TASK_THRESHOLD=0.62
DOC_THRESHOLD=0.55
MEMORY_THRESHOLD=0.60
TOOL_GROUP_TOP_K=3

# --- Agent limits ---
MAX_STEPS=12
MAX_SECONDS=300

# --- Browser / scraping ---
# Comma separated domains the browser and scraper may open. "*" allows every domain.
ALLOWED_DOMAINS=localhost,127.0.0.1
HEADLESS=true
SCRAPE_DELAY_SECONDS=1.0
# Only needed if Selenium cannot find Chrome/ChromeDriver automatically:
# CHROME_BINARY=C:\Program Files\Google\Chrome\Application\chrome.exe
# CHROMEDRIVER_PATH=
# CHROMEDRIVER_ARGS=

# --- Email (demo mode logs emails instead of sending them) ---
EMAIL_DEMO_MODE=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- UI ---
API_URL=http://localhost:8000
